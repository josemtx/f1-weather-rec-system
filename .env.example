# Copia a .env y rellena. Python lo lee via python-dotenv; el jar Java lee
# OPENWEATHER_API_KEY y MONGO_DB del entorno real (run-weather-ingestion.ps1 los fija).

# MongoDB. MONGODB_DB no tiene valor por defecto en el codigo: sin ella, ml/ no arranca.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=F1-WeatherRec-Prod

# OpenWeatherMap (pronosticos por circuito): https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Copernicus CDS (ERA5-Land, opcional; sin esto se usa solo NASA POWER)
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=
